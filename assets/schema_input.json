{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/fspassemblypipeline/master/assets/schema_input.json",
    "title": "nf-core/fspassemblypipeline pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "file_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$|^[\\S\\s]*\\/[^\\s\\/]+\\.bam$",
                "errorMessage": "FastQ file for reads 1 must be provided, cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'. Alternatively, for BAM input, this can be the path to the BAM file (must have extension '.bam')"
            },
            "file_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "FastQ file for reads 2 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "type": {
                "type": "string",
                "enum": ["raw", "cleaned", "bam"],
                "errorMessage": "Type must be either 'raw', 'cleaned', 'merged', or 'bam'",
                "meta": ["type"]
            },
            "fasta": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?a\\.gz$",
                "errorMessage": "Fasta file for BAM input must be provided, cannot contain spaces and must have extension '.fa.gz' or '.fasta.gz'"
            },
            "busco": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.tsv$",
                "errorMessage": "This is the table that stores the full BUSCO results"
            },
            "taxid": {
                "type": "integer",
                "errorMessage": "Species TaxiID for decontamination screening, must be a valid NCBI Taxonomy ID (positive integer)",
                "meta": ["taxid"]
            },
            "family": {
                "type": "string",
                "errorMessage": "Taxonomic family name",
                "meta": ["family"]
            },
            "order": {
                "type": "string",
                "errorMessage": "Taxonomic order name",
                "meta": ["order"]
            },
            "class": {
                "type": "string",
                "errorMessage": "Taxonomic class name",
                "meta": ["class"]
            },
            "phylum": {
                "type": "string",
                "errorMessage": "Taxonomic phylum name",
                "meta": ["phylum"]
            }
        },
        "required": ["sample", "file_1", "type"]
    }
}
