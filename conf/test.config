/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/fspassemblypipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '7.GB',
        time: '1.h'
    ]

    // Keep ABYSS lightweight for local test profile runs (e.g. Docker Desktop on laptops).
    withName: '.*:ABYSS_ABYSSPE' {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }

    withName: 'FASTP_TRIM|FASTP_MERGE' {
        cpus   = 1
        memory = 6.GB
        time   = 1.h
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input  = "${projectDir}/assets/samplesheet.csv"

    // FCS-GC
    db_path = 'https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/FCS/database/test-only/test-only.manifest'
}
