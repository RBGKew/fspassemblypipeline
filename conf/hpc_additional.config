executor {
    name = 'slurm'
}

process {
    errorStrategy = 'retry'
    maxRetries    = 3
    // Queue assignments for nf-core labels
    // More than 32 GB of memory: himem
    // 32 GB or less:
    //    Under 6 hours: short
    //    6 hours to under 24 hours: medium
    //    24 hours or longer: long
    queue = { task.memory <= 32.GB ? (task.time < 6.h ? 'short' : task.time < 24.h ? 'medium' : 'long') : 'himem' }

    withLabel:process_high_memory {
        queue = 'himem'
    }

    withLabel:process_gpu {
        queue = 'gpu'
    }

    withName: '.*FASTK.*' {
        memory = { 8.GB * task.attempt }
        cpus   = { 4 * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'GENESCOPEFK_P1' {
        publishDir = [
            pattern: '*{txt,log,_linear_plot.png}'
        ]
    }

    withName: 'GENESCOPEFK_P2' {
        publishDir = [
            pattern: '*{txt,log,_linear_plot.png}'
        ]
    }

    withName: 'KMERGENIE' {
        publishDir = [
            pattern: '*_report.html'
        ]
    }

        withName: '.*ABYSS.*' {
        publishDir = [ enabled: false ]
    }

    withName: '.*MEGAHIT.*' {
        memory = { 16.GB * task.attempt }
        cpus   = { 16 * task.attempt }
        time   = { 8.h  * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: '.*MINIA.*' {
        memory = { 10.GB * task.attempt }
        cpus   = { 8 * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: '.*MASURCA.*' {
        publishDir = [ enabled: false ]
    }

    withName: '.*SPADES.*' {
        publishDir = [ enabled: false ]
    }

    withName: '.*SPARSEASSEMBLER.*' {
        memory = { 10.GB * task.attempt }
        time   = { 8.h  * task.attempt }
        cpus   = { 1 }
	    errorStrategy = 'ignore'
        publishDir = [ enabled: false ]
    }

    withName: 'MERQURYFK_MERQURYFK' {
        memory = { 8.GB * task.attempt }
        cpus   = { 4 * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [
            pattern: '*.{ln.png,completeness.stats,qv}'
        ]
    }

    withName: 'QUAST' {
        memory = { 8.GB * task.attempt }
        cpus   = { 4 * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [
            pattern: '*.tsv'
        ]
    }

    withName: 'BUSCO_BUSCO' {
        publishDir = [ enabled: false ]
    }

    withName: 'BUSCO_SPECIFIC' {
        publishDir = [ enabled: false ]
    }

    withName: 'EXTRACTDRAFTMETRICS' {
        publishDir = [ enabled: false ]
    }

    withName: 'PYPOLCA_RUN' {
        memory = { 16.GB * task.attempt }
        cpus   = { 16 * task.attempt }
        time   = { 8.h  * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'MERQURYFK_FINAL' {
        memory = { 8.GB * task.attempt }
        cpus   = { 4 * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [
            pattern: '*.{ln.png,completeness.stats,qv}'
        ]
    }

    withName: 'QUAST_FINAL' {
        memory = { 8.GB * task.attempt }
        cpus   = { 4 * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [
            pattern: '*.tsv'
        ]
    }

    withName: 'BWAMEM2_INDEX' {
        publishDir = [ enabled: false ]
    }

   withName: 'BWAMEM2_MEM' {
        memory = { 16.GB }
        cpus   = { 16 }
        time   = { 8.h  * task.attempt }
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }

    withName: 'EXTRACTASSEMBLYMETRICS' {
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_CSI' {
        publishDir = [ enabled: false ]
    }

   withName: 'TIARA_TIARA' {
         publishDir = [
            saveAs: { filename ->
                if (filename.contains('log')) return null
                return filename
            }
       ]
    }

   withName: 'FCSGX_RUNGX' {
        maxForks = 1
        time   = { 12.h  * task.attempt }
        memory = { 512.GB }
        cpus   = { 6 * task.attempt }
        publishDir = [
             saveAs: { filename ->
                 if (filename.endsWith('.txt')) return null
                 return filename
             }
        ]
    }

   withName: 'COMPARISON' {
        publishDir = [
            saveAs: { filename ->
                if (filename.contains('hits')) return null
                return filename
            }
        ]
    }
}
