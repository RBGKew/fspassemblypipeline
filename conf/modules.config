    withName: 'CONVERTFCSRPT' {
        publishDir = [
            path: { "${params.outdir}/decontamination/convertfcsrpt" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMPARISON' {
        publishDir = [
            path: { "${params.outdir}/decontamination/comparison" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

     withName: 'CREATE_PROJECT_YAML' {
        publishDir = [
            path: { "${params.outdir}/decontamination/create_yaml" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

     withName: 'BLOBTOOLKIT_CREATEBLOBDIR' {
        publishDir = [
            path: { "${params.outdir}/decontamination/blobtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
