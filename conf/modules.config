/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'FASTP_TRIM' {
        ext.args = {
            [
                params.fastp_trim_min_length != null ? "-l ${params.fastp_trim_min_length}" : '',
                params.fastp_trim_poly_g_min_len != null ? "--poly_g_min_len ${params.fastp_trim_poly_g_min_len}" : '',
                params.fastp_trim_front1 != null ? "--trim_front1 ${params.fastp_trim_front1}" : '',
                params.fastp_trim_dedup ? '--dedup' : '',
                params.fastp_trim_cut_window_size != null ? "-W ${params.fastp_trim_cut_window_size}" : '',
                params.fastp_trim_cut_front ? '-5' : '',
                params.fastp_trim_cut_tail ? '-3' : '',
                params.fastp_trim_low_complexity_filter ? "--low_complexity_filter ${params.fastp_trim_complexity_threshold}" : '',
                params.fastp_extra_args ? "${params.fastp_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastp/trimmed/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTP_MERGE' {
        ext.args = {
            [
                params.fastp_merge_min_length != null ? "-l ${params.fastp_merge_min_length}" : '',
                params.fastp_merge_overlap_len_require != null ? "--overlap_len_require ${params.fastp_merge_overlap_len_require}" : '',
                params.fastp_merge_overlap_diff_limit != null ? "--overlap_diff_limit ${params.fastp_merge_overlap_diff_limit}" : '',
                params.fastp_extra_args ? "${params.fastp_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastp/merged/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        ext.args = '--all'  // add any extra arguments
        publishDir = [
            path: { "${params.outdir}/R1R2/reads_length/${meta.id}/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTK_FASTK' {
        ext.args = {
            [
                "-k${params.fastk_kmer}",
                params.fastk_t != null ? "-t${params.fastk_t}" : '',
                (params.fastk_profile_output == null || params.fastk_profile_output) ? '-p' : '',
                (params.fastk_verbose == null || params.fastk_verbose) ? '-v' : '',
                params.fastk_extra_args ? "${params.fastk_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTK_HISTEX' {
        ext.args = {
            [
                params.histex_g_output ? '-G' : '',
                params.histex_extra_args ? "${params.histex_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPADES' {
        ext.args = {
            [
                "-k ${params.spades_kmer_list}",
                params.spades_extra_args ? "${params.spades_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/R1R2/manual/${meta.id}/spades" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEGAHIT' {
        ext.args = {
            [
                "--k-list ${params.megahit_kmer_list}",
                params.megahit_extra_args ? "${params.megahit_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/R1R2/manual/${meta.id}/megahit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIA' {
        ext.args = {
            [
                "-kmer-size ${params.minia_kmer}",
                params.minia_extra_args ? "${params.minia_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/R1R2/manual/${meta.id}/minia" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RENAME_ASSEMBLIES' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUSCO_BUSCO' {
        ext.args = {
            [
                params.busco_extra_args ? "${params.busco_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/R1R2/manual/${meta.id}/busco_general/${meta.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUSCO_SPECIFIC' {
        ext.args = {
            [
                params.busco_extra_args ? "${params.busco_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/R1R2/manual/${meta.id}/busco_specific/${meta.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MERQURYFK_MERQURYFK' {
        publishDir = [
            path: { "${params.outdir}/R1R2/manual/${meta.id}/merquryfk/${meta.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUAST' {
        ext.args = {
            [
                params.quast_extra_args ? "${params.quast_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
