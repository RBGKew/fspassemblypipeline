                params.histex_extra_args ? "${params.histex_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/preprocessing/fastk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENESCOPEFK_P1' {
        ext.args = '-p 1 -k 17'
        publishDir = [
            path: { "${params.outdir}/preprocessing/genescopefk/${meta.id}/p1" },
